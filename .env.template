# Environment Configuration Template for Production
# Copy this file to .env and fill in the actual values

# Application Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Database Configuration
MONGO_URI=mongodb://your_db_user:your_secure_password@mongodb:27017/patientoutcome?authSource=admin
MONGODB_USERNAME=your_db_user
MONGODB_PASSWORD=your_secure_password
MONGODB_DATABASE=patientoutcome

# Rate Limiting
COMMON_RATE_LIMIT_MAX_REQUESTS=100
COMMON_RATE_LIMIT_WINDOW_MS=900000

# Session Configuration
# IMPORTANT: Generate a strong, random secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Session max-age in hours. With rolling sessions the timer resets on every request,
# so active users are never logged out. Increase for low-activity environments.
# Default: 36 hours
SESSION_MAX_AGE_HOURS=36

# Password Hashing
HASH_SALT_ROUNDS=10

# Allow database seeding in production (use with caution!)
# Set to 'true' only for initial deployment with demo data
# ALLOW_SEED=false

# SMTP Configuration for Feedback/Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_TO_EMAIL=feedback@your-domain.com


BACKUP_MASTER_KEY="lkfdsgj940ipgojewklmgfds43poirewsfsa324tgfdtrgserg"
BACKUP_RETENTION_DAYS="30"

# Case Access Code Configuration
# Validity period for case-level access codes (codes bound to a patient case, not a specific consultation)
# Format: Can be either:
#   - Relative: "10y" (10 years), "5y" (5 years), "2y" (2 years)
#   - Fixed date: "2030-12-31" (YYYY-MM-DD format)
# Default: 10 years from activation
DEFAULT_CASE_ACCESS_CODE_VALID_UNTIL="10y"
BACKUP_STORAGE_PATH="/backups/patientoutcome"

# Browser push notifications (Web Push / VAPID)
BACKEND_URL=http://localhost:40001
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com
NOTIFICATIONS_ENABLED=true
# Optional comma-separated extra recipients for admin form-completion alerts
NOTIFICATION_ADMIN_EMAILS=